# Optional future data integrations. The demo works without these values.
# NEXT_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_token
# Server-only. No NEXT_PUBLIC_ prefix. Auto mode uses mocks if this is missing.
OPEN_CHARGE_MAP_API_KEY=
# auto | mock | openchargemap | database (read imported snapshots, no upstream page requests)
CHARGING_DATA_PROVIDER=auto
# Optional admin/scheduler ingestion only. Never share these with browser code.
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_secret
# CHARGING_INGESTION_SECRET=at_least_32_random_characters
# Supabase is optional. Use a dedicated ChargeOnce development project or local CLI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT alternative (never a service_role JWT):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required exact site origin for deployed email confirmation and magic links.
# Add it to the Supabase Auth Site URL and redirect allowlist.
# CHARGEONCE_SITE_URL=https://your-chargeonce-domain.example
# Development defaults to http://localhost:3000; production has no localhost fallback.
# Local seed script only; remote hosts are refused. NEVER prefix DB passwords NEXT_PUBLIC.
# CHARGEONCE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
