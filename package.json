{
  "name": "chargeonce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts docs README.md *.json *.ts *.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:seed": "node scripts/seed.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "charging:import": "node --env-file-if-exists=.env.local scripts/import-chargers.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
